{
  "name": "dsh-github-auth",
  "version": "0.3.0",
  "type": "module",
  "main": "./index.js",
  "description": "一键准备工具并登录 GitHub；管理账号、权限与本机退出，检查 SSH 和仓库访问。",
  "license": "MIT",
  "icon": "assets/icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./assets/*": "./assets/*"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "locale",
    "assets",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "devDependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "jsdom": "^30.1.2"
  },
  "disclosure": {
    "cloud": true,
    "network": [
      "https://github.com",
      "https://api.github.com",
      "ssh://git@github.com:22",
      "https://release-assets.githubusercontent.com",
      "https://objects.githubusercontent.com",
      "https://github-releases.githubusercontent.com"
    ],
    "offlineMode": false,
    "permissions": [
      "process:spawn:gh auth and read-only probes",
      "credentials:manage:GitHub CLI",
      "filesystem:GitHub CLI config via gh",
      "process:spawn:official gh version check and archive extraction",
      "filesystem:write:user-local-bin-gh"
    ],
    "retention": "gh manages credentials; official CLI stays in user-local-bin; download temporary files are removed",
    "telemetry": false
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oliblue-evan/dsh-github-auth.git"
  },
  "author": "李敖 (oliblue)",
  "engines": {
    "node": ">=18"
  }
}
